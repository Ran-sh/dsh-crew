name: Publish

# Publishes to npm when a version tag is pushed, authenticated by OIDC rather
# than a token: the credential is minted per run from this workflow's identity,
# so there is no long-lived secret to leak, rotate, or expire. Provenance is
# generated automatically.
#
# The merge or tag push is the authorization. Nothing else to approve.
#
# Requires, once, on npmjs.com → the package → Settings → Trusted Publisher:
#   Publisher      GitHub Actions
#   Organization   Ran-sh
#   Repository     dsh-crew
#   Workflow       publish.yml          (filename only, must exist here)
#   Allowed actions  direct `npm publish` must be permitted — if only
#                    `npm stage publish` is allowed the run stages the release
#                    and still waits for a human, which defeats the point.

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: read
  id-token: write # Required for OIDC; without it the publish cannot authenticate

jobs:
  publish:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4
        with:
          version: 10
          run_install: false

      # No dependency cache in a release build: a poisoned cache would run in
      # the job that holds publish authority.
      - uses: actions/setup-node@v4
        with:
          node-version: 22.14.0
          registry-url: 'https://registry.npmjs.org'

      # Trusted publishing needs npm CLI 11.5.1+; the one bundled with Node 22
      # is older, and the failure it gives is an opaque 404 rather than a
      # version complaint.
      - name: Use an npm that supports trusted publishing
        run: npm install -g npm@^11.5.1

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Unit and integration tests
        shell: bash
        run: |
          files=$(find test -maxdepth 1 -name '*.test.mjs' \
            ! -name 'hub-windows.test.mjs' \
            ! -name 'workspace-audit.test.mjs' -print)
          node --test $files

      - name: Build client
        run: pnpm run build:client

      - name: Fail if the build changed a committed artifact
        shell: bash
        run: |
          # Only tracked files: an untracked scratch file is not a changed
          # artifact, and failing on one would block a release for nothing.
          if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
            echo "::error::the build produced a different artifact than the commit;"
            echo "::error::rebuild and commit before tagging."
            git --no-pager diff --stat
            exit 1
          fi

      # A tag that disagrees with package.json would publish one version under
      # another's name, and npm does not let that be undone.
      - name: Fail if the tag and the package version disagree
        shell: bash
        run: |
          version=$(node -p "require('./package.json').version")
          if [ "v$version" != "${GITHUB_REF_NAME}" ]; then
            echo "::error::tag ${GITHUB_REF_NAME} does not match package.json version $version"
            exit 1
          fi

      - name: Publish
        run: npm publish --access public
