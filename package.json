{
  "name": "@ran-sh/dsh-crew",
  "version": "1.0.4",
  "type": "module",
  "main": "./src/hub/entry.mjs",
  "bin": {
    "dsh-crew": "bin/dsh-crew.mjs"
  },
  "description": "DeepSeek Harness plugin: dispatch work to DSH agents from Claude Code / Codex, as native subagents with live progress",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "mcp": "node src/server.mjs",
    "build:client": "tsdown src/client/entry.tsx --format cjs --platform browser --target es2022 --tsconfig tsconfig.client.json --deps.never-bundle react --deps.never-bundle react/jsx-runtime --deps.never-bundle react-dom --deps.never-bundle react-dom/client --out-dir .client-build --clean --logLevel warn && node scripts/build-client.mjs",
    "verify:npm-install": "node scripts/verify-npm-install.mjs",
    "verify:npm-install:official": "node scripts/verify-npm-install.mjs --with-official-dsh",
    "verify:official-bridge": "node scripts/verify-official-bridge-e2e.mjs --diagnostic-only"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.4",
    "zod": "^3.24.0"
  },
  "exports": {
    ".": "./src/hub/entry.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-minimal": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-todo": "0.1.2-rc.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
